[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://assets/events/event_def.gd" id="1_event_def"]
[ext_resource type="Script" path="res://assets/events/event_def_option.gd" id="2_event_def_option"]
[ext_resource type="Script" path="res://assets/events/event_def_effect.gd" id="3_event_def_effect"]

[sub_resource type="Resource" id="Effect_lianqi_cost"]
script = ExtResource("3_event_def_effect")
kind = 0
amount = -40

[sub_resource type="Resource" id="Effect_lianqi_card"]
script = ExtResource("3_event_def_effect")
kind = 3
card_id = "mu_yao"

[sub_resource type="Resource" id="Option_lian"]
script = ExtResource("2_event_def_option")
text = "借丹炉一用，炼一炉木灵丹"
result_text = "你取出随身灵材投入丹炉。半个时辰后炉火转青，一炉木灵丹成色竟比预期还好。丹主收了四十灵石炉资，笑眯眯地目送你离开。"
effects = Array[ExtResource("3_event_def_effect")]([SubResource("Effect_lianqi_cost"), SubResource("Effect_lianqi_card")])

[sub_resource type="Resource" id="Effect_lianqi_cult"]
script = ExtResource("3_event_def_effect")
kind = 1
amount = 25

[sub_resource type="Resource" id="Option_guanmo"]
script = ExtResource("2_event_def_option")
text = "不炼了，在旁观摩丹师的火候手法"
result_text = "你婉拒了丹主，只站在一旁看那炉中真火如何吞吐。青转赤、赤转白，火候收放的间隙里藏着炼丹一道的真意。看罢一炉，你对灵力运转的把控又精进了几分。"
effects = Array[ExtResource("3_event_def_effect")]([SubResource("Effect_lianqi_cult")])

[resource]
script = ExtResource("1_event_def")
event_id = "lian_dan_lian_qi_001"
title = "山间丹炉"
body = "山道旁的岩壁下，一位游方丹师支起了随身丹炉，炉火正旺。「道友，借炉炼丹，炉资四十灵石。」他头也不抬，「成色如何，全看你自己的本事——当然，若是不炼，站在旁边看看火候，也不失为一桩机缘。」"
options = Array[ExtResource("2_event_def_option")]([SubResource("Option_lian"), SubResource("Option_guanmo")])
