[gd_resource type="Resource" script_class="CardTemplate" format=3]

[ext_resource type="Script" path="res://src/core/card_system/effect_entry.gd" id="1_effect_entry"]
[ext_resource type="Script" path="res://src/core/card_system/card_template.gd" id="2_card_template"]

[sub_resource type="Resource" id="Resource_xuesha_damage"]
script = ExtResource("1_effect_entry")
effect_type = &"damage_multiplier"
value = 100
target = &"single_enemy"
trigger = &""

[sub_resource type="Resource" id="Resource_xuesha_heal"]
script = ExtResource("1_effect_entry")
effect_type = &"heal"
value = 2
target = &"self"
trigger = &"kill"

[resource]
script = ExtResource("2_card_template")
card_id = &"xue_sha_zhang"
name = "血杀掌"
type = 5
rarity = 1
cost = 1
description = "造成攻击力×1.0的伤害，击杀目标后回复2点生命。"
flavor_text = "掌落见血，血即是命。"
effects = Array[ExtResource("1_effect_entry")]([SubResource("Resource_xuesha_damage"), SubResource("Resource_xuesha_heal")])
target_type = &"single_enemy"
