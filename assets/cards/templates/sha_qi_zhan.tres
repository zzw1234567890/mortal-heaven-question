[gd_resource type="Resource" script_class="CardTemplate" format=3]

[ext_resource type="Script" path="res://src/core/card_system/effect_entry.gd" id="1_effect_entry"]
[ext_resource type="Script" path="res://src/core/card_system/card_template.gd" id="2_card_template"]

[sub_resource type="Resource" id="Resource_shaqizhan_damage"]
script = ExtResource("1_effect_entry")
effect_type = &"damage_multiplier"
value = 150
target = &"single_enemy"

[sub_resource type="Resource" id="Resource_shaqizhan_debuff"]
script = ExtResource("1_effect_entry")
effect_type = &"debuff_atk"
value = 1
duration_turns = 2
target = &"single_enemy"

[resource]
script = ExtResource("2_card_template")
card_id = &"sha_qi_zhan"
name = "煞气斩"
type = 5
rarity = 1
cost = 1
description = "造成攻击力×1.5的伤害，并使目标攻击力降低1点，持续2回合。"
flavor_text = "斩出的不是剑，是煞。"
effects = Array[ExtResource("1_effect_entry")]([SubResource("Resource_shaqizhan_damage"), SubResource("Resource_shaqizhan_debuff")])
target_type = &"single_enemy"
