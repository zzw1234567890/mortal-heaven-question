[gd_resource type="Resource" script_class="CardTemplate" format=3]

[ext_resource type="Script" path="res://src/core/card_system/effect_entry.gd" id="1_effect_entry"]
[ext_resource type="Script" path="res://src/core/card_system/card_template.gd" id="2_card_template"]

[sub_resource type="Resource" id="Resource_peiyuandan_heal"]
script = ExtResource("1_effect_entry")
